{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrokFree",
  "version": "0.9.4",
  "identifier": "app.grokfree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GrokFree",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#f5f7fb"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/**",
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https: http:; connect-src 'self' ipc: http://ipc.localhost https://api.x.ai https://*.x.ai https://api.github.com https://github.com https://*.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GrokFree",
    "homepage": "https://github.com/qingyou0420/GrokFree",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {}
}
